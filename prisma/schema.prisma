generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  username  String   @unique
  email     String   @unique
  password  String?
  discordId String?  @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  avatar    String?
  bannerUrl String?
  bannerPosition Int  @default(50)   // vertical focus of the cover banner (object-position %, 0=top, 100=bottom)
  bannerStyle String @default("full") // "full" = full-screen background, "cover" = header strip
  bio       String?
  profileSong String?               // one audio URL that plays on the profile (host/format-gated server-side)
  arisePoints Int      @default(0)   // community currency
  xp          Int      @default(0)   // drives level (max level 10), separate from currency
  usernameChanges Int  @default(0)   // first username change is free, then costs Arise Points
  role        String   @default("USER") // LEAD_DEV | ADMIN | USER — tied to the account, survives username changes
  isPrivate   Boolean  @default(false)
  isAdmin     Boolean  @default(false)
  theme       String   @default("dark")
  
  purchasedBanners String[] @default([])
  purchasedTags    String[] @default([])
  purchasedRoles   String[] @default([])
  purchasedEffects String[] @default([])
  purchasedThemes  String[] @default([])
  purchasedColors  String[] @default([])
  purchasedFonts   String[] @default([])
  purchasedFrames  String[] @default([])

  shards           Int      @default(0)  // dust from duplicate cards; crafts/foils/relic packs
  duelItems        String[] @default([])  // bag of duel consumables; one entry = one charge
  claimedSets      String[] @default([])  // set names whose completion reward has been paid
  showcaseCards    String[] @default([])  // up to 3 card ids pinned to the profile
  // RETIRED — the arena-effect feature was removed. Columns kept rather than
  // dropped: `prisma db push --accept-data-loss` runs on every deploy and a
  // dropped column is gone for good. They are read by nothing and cost
  // nothing. Safe to delete deliberately, later.
  purchasedArenaEffects String[] @default([])
  activeArenaEffect     String?
  arenaChestPity        Int      @default(0)
  arenaChestPityChest   String   @default("")
  cardTitle        String?                // title earned from completing a set
  equippedTitles   String[] @default([])  // the titles WORN on the profile, wearer-ordered, max 3
  cards            UserCard[]
  cardListings     CardListing[] @relation("CardListings")

  activeRole       String?
  activeTag        String?
  activeEffect     String?
  activeTheme      String?
  activeColor      String?
  activeFont       String?
  activeFrame      String?

  watchlist    WatchlistItem[]
  likes        AnimeLike[]
  followers    Follow[] @relation("followers")
  following    Follow[] @relation("following")
  notifications Notification[] @relation("userNotifications")
  triggeredNotifications Notification[] @relation("actorNotifications")
  comments     Comment[]
  commentVotes CommentVote[]
  ratings        Rating[]
  commentReports CommentReport[]
  pollVotes      PollVote[]
  gemVotes       GemVote[]
  pointLogs    PointLog[]
  conversationsAsUser1 Conversation[] @relation("ConversationUser1")
  conversationsAsUser2 Conversation[] @relation("ConversationUser2")
  messages             Message[]
  announcements        Announcement[]
  announcementLikes    AnnouncementLike[]
  announcementComments AnnouncementComment[]

  createdInvites       InviteCode[] @relation("createdInvites")
  usedInvite           InviteCode?  @relation("usedInvites")

  novelBookmarks       NovelBookmark[]
  manhwaBookmarks      ManhwaBookmark[]
}

model Conversation {
  id        String   @id @default(uuid())
  user1Id   String
  user2Id   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user1     User      @relation("ConversationUser1", fields: [user1Id], references: [id], onDelete: Cascade)
  user2     User      @relation("ConversationUser2", fields: [user2Id], references: [id], onDelete: Cascade)
  messages  Message[]

  @@unique([user1Id, user2Id])
}

model Message {
  id             String   @id @default(uuid())
  conversationId String
  senderId       String
  content        String
  isRead         Boolean  @default(false)
  createdAt      DateTime @default(now())

  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User         @relation(fields: [senderId], references: [id], onDelete: Cascade)
}

model Comment {
  id        String   @id @default(uuid())
  userId    String
  animeId   Int?     // Optional: for tying discussions to specific anime
  animeTitle String? // Denormalized title for rendering in global feed
  // The episode a comment was left on, so the global feed can link back to
  // that exact episode rather than the series. Null on every comment made
  // before this shipped, and on comments left from the series page — both
  // are legitimately series-level and fall back to the anime page.
  episodeNo  Int?

  // Manhwa support
  mangaId      String?  // The AsuraScans slug (e.g. 'standard-of-reincarnation')
  mangaTitle   String?  // Title for global feed rendering
  chapterId    String?  // The specific chapter ID
  chapterTitle String?  // e.g. 'Chapter 190'

  // Novel support (novel-level discussion, NOT per-chapter)
  novelId      String?  // novel source id, e.g. 'nf:overlord-ln'
  novelTitle   String?  // Title for global feed rendering

  // Guild board — a comment stamped with a guildId lives on that guild's
  // board and nowhere else (the forum and global feeds exclude it). The board
  // RIDES the existing comment machinery: votes, replies, polls, reports all
  // work unchanged. Nullable so every existing comment stays exactly as it is.
  guildId   String?

  parentId  String?  // Optional: references another comment
  mediaUrl  String?  // Optional: attached image/GIF URL
  // Forum fields. A comment with NO anime/manga/novel id and no parent is a
  // standalone forum post; these give it a headline and a topic. Both nullable
  // so every existing comment stays exactly as it is.
  title     String?  // forum post headline, max 30 chars
  tag       String?  // General | Discussion | Art | Theory | News | Question | Spoiler | Meme
  content   String
  isPinned  Boolean  @default(false)
  blessed   Boolean  @default(false) // an admin/lead-dev granted this comment a Divine Blessing
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent    Comment?      @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies   Comment[]     @relation("CommentReplies")
  votes     CommentVote[]
  reports   CommentReport[]
  poll      Poll?

  @@index([guildId])
}

/// A poll attached to one forum post. Optional and one-per-post: a post
/// either asks a question or it doesn't. Deleting the post takes the poll,
/// its options and every vote with it.
model Poll {
  id        String   @id @default(uuid())
  commentId String   @unique
  question  String
  /// null = never closes. Past this moment the server refuses new votes,
  /// so a closed poll is closed for everyone rather than just hidden.
  closesAt  DateTime?
  createdAt DateTime @default(now())

  comment   Comment      @relation(fields: [commentId], references: [id], onDelete: Cascade)
  options   PollOption[]
  votes     PollVote[]
}

model PollOption {
  id     String @id @default(uuid())
  pollId String
  text   String
  /// Preserves the order the author typed them in; without it the options
  /// come back in whatever order the database feels like.
  order  Int

  poll   Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  votes  PollVote[]

  @@index([pollId])
}

/// One vote per member per poll — changing your mind UPDATES the row, so
/// the tallies can't be stuffed by voting repeatedly.
model PollVote {
  id        String   @id @default(uuid())
  pollId    String
  optionId  String
  userId    String
  createdAt DateTime @default(now())

  poll      Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  option    PollOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([pollId, userId])
  @@index([optionId])
}

model CommentVote {
  id        String   @id @default(uuid())
  commentId String
  userId    String
  value     Int      // 1 for upvote, -1 for downvote

  comment   Comment  @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([commentId, userId])
}

/// A member's 1-10 score for one thing. `targetKey` is a single opaque
/// string rather than four nullable columns, so anime, manhwa series,
/// manhwa chapters, novels and episodes all rate through one table:
///   anime:21 · anime:21:ep:5 · manhwa:<slug> · manhwa:<slug>:<chapterId>
///   novel:<id>
/// One row per member per target — rating again UPDATES, never stacks.
// HIDDEN GEMS — one pick per person, per week, per mode. The community
// nominates something underrated; the week's tally is the ranking.
//
// The week key is stored rather than derived at read time, so a vote stays in
// the week it was cast no matter when it is counted. Title and cover are
// denormalised because the series live in external sources (AsuraScans,
// MangaDex, the novel sites) and there is no local row to join against — a
// scrape that later drops a title must not blank the leaderboard behind it.
model GemVote {
  id        String   @id @default(uuid())
  userId    String
  mediaType String   // "manhwa" | "novel"
  mediaId   String   // source id, e.g. a bare Asura slug or "mdx:<uuid>"
  title     String
  cover     String?
  week      String   // ISO week key, e.g. "2026-W31"
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // One pick per person per week per mode — changing your mind replaces the
  // pick rather than adding a second. This uniqueness IS the anti-stuffing
  // guarantee, so the endpoint must take identity from the token, never the body.
  @@unique([userId, week, mediaType])
  @@index([week, mediaType])
}

model Rating {
  id        String   @id @default(uuid())
  userId    String
  targetKey String
  value     Int      // 1..10
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, targetKey])
  @@index([targetKey])
}

/// A member flagging one comment. Unique per member so a single person
/// can't inflate a report count by tapping twice.
model CommentReport {
  id        String   @id @default(uuid())
  commentId String
  userId    String
  reason    String?
  createdAt DateTime @default(now())

  comment   Comment  @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([commentId, userId])
  @@index([commentId])
}

model Follow {
  followerId  String
  followingId String
  createdAt   DateTime @default(now())

  follower  User @relation("following", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation("followers", fields: [followingId], references: [id], onDelete: Cascade)

  @@id([followerId, followingId])
}

model WatchlistItem {
  id         String   @id @default(uuid())
  userId     String
  anilistId  Int
  title      String
  coverImage String?
  genre      String?  // The primary genre of the anime
  status     String   // "INTERESTED", "WATCHING", "WAITING", "FINISHED", "DROPPED"
  score      Int?     // 0-10 or 0-100
  notes      String?
  // Runtime metadata from AniList, used to compute watch TIME (hours) — which
  // drives both the finish payout and the "Hours Watched" stat on the profile.
  // Nullable: older rows predate this and are backfilled by backfill-runtimes.ts.
  episodes   Int?     // total episode count
  duration   Int?     // minutes per episode (~24 for most TV anime)
  // Resume point. Previously this lived ONLY in localStorage, so "Continue
  // watching" showed a bare "CONTINUE" on any device that hadn't played the
  // episode locally, and everything was lost on clearing browser data.
  // All nullable so `prisma db push` applies this additively with no data loss.
  progressEpisode  Int?      // which episode you're on (1-based)
  progressSeconds  Int?      // position within that episode
  progressDuration Int?      // that episode's length, for the % bar
  progressAt       DateTime? // last time the resume point moved
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, anilistId])
}

// A public "Like" / favourite for an anime. Independent from WatchlistItem so an
// anime can be both liked and tracked. Shown on the user's public profile.
model AnimeLike {
  id         String   @id @default(uuid())
  userId     String
  anilistId  Int
  title      String
  coverImage String?
  createdAt  DateTime @default(now())

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, anilistId])
}

model CacheItem {
  id        String   @id @default(uuid())
  key       String   @unique
  data      String   // JSON string
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  actorId   String
  type      String   // e.g., "NEW_FOLLOWER"
  message   String
  isRead    Boolean  @default(false)
  link      String?  // Optional link to navigate to
  createdAt DateTime @default(now())

  user      User     @relation("userNotifications", fields: [userId], references: [id], onDelete: Cascade)
  actor     User     @relation("actorNotifications", fields: [actorId], references: [id], onDelete: Cascade)
}

model PointLog {
  id        String   @id @default(uuid())
  userId    String
  amount    Int
  reason    String
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// A card put up for sale.
//
// The copies are ESCROWED here — they leave the seller's UserCard row the
// moment the listing is created, not when it sells. Without that a seller
// could list two copies and then dust them, and the listing would later hand
// a buyer cards that no longer exist. The listing IS the custody record.
//
// foil and level are copied onto the listing because they are properties of
// the specific copies being sold, and the seller may still hold others.
model CardListing {
  id        String    @id @default(uuid())
  sellerId  String
  sellerName String
  cardId    String    // id in the server-side card catalog
  qty       Int       @default(1)
  foil      Boolean   @default(false)
  level     Int       @default(1)
  price     Int       // Arise Points for the WHOLE lot
  status    String    @default("ACTIVE") // ACTIVE | SOLD | CANCELLED
  buyerId   String?
  buyerName String?
  createdAt DateTime  @default(now())
  soldAt    DateTime?

  seller    User      @relation("CardListings", fields: [sellerId], references: [id], onDelete: Cascade)

  @@index([status, cardId])
  @@index([sellerId, status])
}

// A collectible card a user owns, with how many copies. `count > 1` = dupes,
// which can be dusted into shards. Unique per (user, card) so counts live on
// one row that upserts on every pull.
// NOTE: skillLevel below is on UserCard — a skill belongs to YOUR copy of a
// legendary, not to the card in the abstract, exactly like level does.
// ROLLED STATS live on the owned copy, not the card: two people holding the
// same Squire hold different Squires. Nullable because every copy pulled
// before this existed has no roll and must keep falling back to the printed
// stats — a null here means "printed", never "zero".
model UserCard {
  id        String   @id @default(uuid())
  userId    String
  cardId    String   // id in the server-side card catalog (cardCatalog.ts)
  count     Int      @default(1)
  foil      Boolean  @default(false) // shard-bought prestige variant
  // Fell in a duel you LOST. The card is never deleted — it sleeps, and comes
  // back either by spending shards or by pulling another copy from a pack.
  hibernating Boolean @default(false)
  // Shard-bought power. Levels raise ATK and HP in duels, so a common you
  // actually invested in can outfight a legendary nobody touched.
  level     Int      @default(1)
  // Legendary skills level on their OWN shard track, separate from `level`.
  // A card level raises ATK and HP; a skill level raises the one thing that
  // card uniquely does, so a player chooses which to sink shards into rather
  // than having the choice made for them. Meaningless on non-legendaries,
  // which have no skill in the catalog.
  skillLevel Int     @default(1)
  // The per-copy roll, taken once when the copy is pulled. Null = printed
  // stats, which is every copy that predates this and every support and
  // ground card (their printed effect IS the card, so there is nothing to
  // roll). Levels and forge ranks apply ON TOP of these, so a poor roll is
  // something shards can close rather than a permanent loss.
  rolledHp   Int?
  rolledAtk  Int?
  // How many times this copy has been MERGED — a spare of the same rank fed
  // into it, plus shards, to raise its roll permanently. Capped at MERGE_MAX
  // in the catalog. Stored rather than derived because the roll it raises is
  // written straight into rolledHp/rolledAtk: without this counter there is
  // nothing left to say how much of that number was pulled and how much was
  // paid for, and the cap could be walked past forever.
  merges     Int      @default(0)
  // ── Dungeon Dispatch condition ── deliberately separate from `hibernating`
  // (the duel sleep): a card asleep from a lost duel can still raid, and a
  // card dead in a dungeon can still duel. Two modes, two bodies.
  // ── THE FORGE ── flat stat training, bought with shards, deliberately
  // expensive: cost doubles per rank. Separate tracks so a player can shape
  // a card — glass cannon or anvil — instead of only raising the level dial.
  atkForge   Int     @default(0)     // +1 flat ATK per rank, capped
  hpForge    Int     @default(0)     // +2 flat HP per rank, capped
  mythAffix  String?                 // a Mythic copy's rolled stat affix (MYTHIC_AFFIXES key)
  mythMod    String?                 // a Mythic copy's rolled eruption mod (MYTHIC_MODS key)
  // ── Guild Raid Boss ── a card hurt in a raid RESTS until this timestamp
  // (no heal system exists, so injuries self-expire — a timer, not a flag).
  // Deliberately separate from `hibernating`: duel sleep and raid rest are
  // two modes, two bodies, same as the old dungeon comment above intended.
  raidRestUntil DateTime?
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, cardId])
  @@index([userId])
}

// A Dungeon Dispatch run. The party auto-raids SERVER-SIDE, one floor per
// /advance request — the client renders events, it never invents outcomes.
// Recall banks the earnings; a wipe forfeits everything unbanked (the deaths
// still count — the dungeon keeps what it takes either way). Follows the
// Duel pattern: plain-string userId, no relation, status as a documented
// string.
// One physical COPY of a legendary card. UserCard.count stays the source of
// truth for HOW MANY you own; a print is the identity of each copy — a global
// serial in mint order plus the condition it was pulled in. Condition and
// serial are cosmetic and market-facing ONLY: nothing in duelRules reads
// them, the same deliberate zero-combat-impact line the arena effects drew.
// No FK relations on purpose — additive columns only, safe under the
// `prisma db push --accept-data-loss` that runs on every deploy.
model CardPrint {
  id        String   @id @default(uuid())
  cardId    String   // id in the server-side card catalog (legendaries only)
  serial    Int      // 1-based, global per cardId, in mint order
  condition String   // "fresh" | "factory" | "rusted" — see prints.ts
  userId    String?  // current holder; null while escrowed in a listing
  listingId String?  // the CardListing holding it while escrowed
  createdAt DateTime @default(now())

  @@unique([cardId, serial])
  @@index([userId])
  @@index([listingId])
}

// Hands out the next serial for a card under a row lock, so two packs opening
// the same legendary at the same moment can never mint the same number. A
// unique-violation retry can't work here — Postgres aborts the surrounding
// transaction on constraint failure, which would kill the whole pack open.
model PrintCounter {
  cardId String @id
  next   Int    @default(1)
}

// A staked, ranked card duel. Both players ante Arise Points; the winner takes
// the pot MINUS a rake that is burned, so competitive play is itself a sink.
// Game state lives in `state` as JSON — the rules engine is server-side only,
// so a client can never invent a result.
model Duel {
  id             String   @id @default(uuid())
  challengerId   String
  challengerName String
  opponentId     String
  opponentName   String
  stake          Int                       // AP each side puts up
  status         String   @default("PENDING") // PENDING | ACTIVE | FINISHED | DECLINED | EXPIRED
  challengerDeck String[] @default([])     // card ids
  opponentDeck   String[] @default([])
  state          String?                   // JSON: fighters, hp, items, log
  // RETIRED with the arena-effect feature. Kept, not dropped — see User.
  challengerArena Boolean @default(false)   // challenger opted in
  opponentArena   Boolean @default(false)   // opponent opted in
  arenaEffect     String?                   // the effect actually in play
  turnUserId     String?
  winnerId       String?
  createdAt      DateTime @default(now())
  expiresAt      DateTime
  finishedAt     DateTime?

  @@index([status])
  @@index([challengerId])
  @@index([opponentId])
}

// Ladder standing. Separate from Duel so the leaderboard is one cheap read.
model DuelRating {
  userId   String @id
  username String
  rating   Int    @default(1000)
  wins     Int    @default(0)
  losses   Int    @default(0)
  streak   Int    @default(0)   // consecutive wins; resets on a loss
  updatedAt DateTime @updatedAt

  @@index([rating])
}

// The Arise Auction House. The SERVER (Lead Dev) is the seller — bids are a
// pure sink: the winning bid's points are deducted at bid time and never paid
// out to anyone, so they leave circulation permanently. userIds are stored as
// plain strings (no FK) so nothing has to change on the User model.
model Auction {
  id            String       @id @default(uuid())
  itemId        String       // shop catalog id, e.g. "effect_outergod"
  itemType      String       // "effect" | "frame"
  title         String       // display-name snapshot at listing time
  startPrice    Int
  minIncrement  Int          @default(100)
  topBid        Int          @default(0)  // 0 = no bids yet
  topBidderId   String?
  topBidderName String?
  bidCount      Int          @default(0)
  status        String       @default("ACTIVE") // ACTIVE | SETTLED | CANCELLED
  endsAt        DateTime
  settledAt     DateTime?
  winnerId      String?
  createdAt     DateTime     @default(now())

  bids          AuctionBid[]

  @@index([status, endsAt])
}

// Append-only bid log — for the "N bids" history UI and audit. NOT load-bearing
// for correctness: Auction.topBid / topBidderId are the authoritative state,
// updated under an optimistic guard so concurrent bids can't corrupt the total.
model AuctionBid {
  id        String   @id @default(uuid())
  auctionId String
  userId    String
  username  String
  amount    Int
  createdAt DateTime @default(now())

  auction   Auction  @relation(fields: [auctionId], references: [id], onDelete: Cascade)

  @@index([auctionId])
}

model Announcement {
  id        String   @id @default(uuid())
  authorId  String
  title     String
  content   String
  tag       String
  image     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  likes     AnnouncementLike[]
  comments  AnnouncementComment[]
}

model AnnouncementLike {
  id             String   @id @default(uuid())
  announcementId String
  userId         String
  createdAt      DateTime @default(now())

  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([announcementId, userId])
}

model AnnouncementComment {
  id             String   @id @default(uuid())
  announcementId String
  userId         String
  content        String
  createdAt      DateTime @default(now())

  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model InviteCode {
  id        String   @id @default(uuid())
  code      String   @unique
  createdBy String
  isUsed    Boolean  @default(false)
  usedBy    String?  @unique
  createdAt DateTime @default(now())

  creator     User  @relation("createdInvites", fields: [createdBy], references: [id], onDelete: Cascade)
  usedByUser  User? @relation("usedInvites", fields: [usedBy], references: [id], onDelete: SetNull)
}

model Novel {
  id          String   @id @default(uuid())
  title       String
  synopsis    String
  author      String
  coverImage  String?
  status      String   @default("ONGOING") // ONGOING, COMPLETED, HIATUS
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  chapters    Chapter[]
}

model Chapter {
  id          String   @id @default(uuid())
  novelId     String
  chapterNum  Int
  title       String
  content     String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  novel       Novel    @relation(fields: [novelId], references: [id], onDelete: Cascade)

  @@unique([novelId, chapterNum])
}

// Tracks a SCRAPED novel on a user's profile. novelId is the source slug
// ("fmtl:<slug>" for FanMTL, or a bare ReadNovelFull slug) — NOT a Novel row —
// so this mirrors ManhwaBookmark (denormalized title/cover, no FK to Novel).
model NovelBookmark {
  id              String   @id @default(uuid())
  userId          String
  novelId         String   // source slug, e.g. "fmtl:omniscient-readers-viewpoint"
  title           String?  // denormalized for profile rendering
  coverImage      String?  // raw source cover URL (proxied client-side via /api/novel-image)
  status          String   @default("READING") // READING, FINISHED, WAITING, INTERESTED, DROPPED
  lastReadChapter String?  // optional reading-progress pointer (plain string; no FK)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, novelId])
}

model ManhwaBookmark {
  id         String   @id @default(uuid())
  userId     String
  mangaId    String   // The AsuraScans slug
  title      String
  coverImage String?
  status     String   @default("READING") // READING, COMPLETED, ON_HOLD, DROPPED, PLAN_TO_READ
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, mangaId])
}

// A Ko-fi payment (donation / membership / shop order), logged by the webhook.
// kofiTxnId is unique so the webhook is idempotent (Ko-fi may retry). Not FK'd
// to User — we keep the row even if the payer never matched an account, so the
// public total still counts it. matchedUserId is set when we resolved the
// Da Vinci username from the payment note.
model Donation {
  id            String   @id @default(uuid())
  kofiTxnId     String   @unique
  type          String   // "Donation" | "Subscription" | "Shop Order"
  fromName      String   // Ko-fi display name of the payer
  amount        Float
  currency      String   @default("GBP")
  message       String?  // the payer's note (where they put their username)
  tierName      String?  // membership tier, if any
  isSubscription Boolean @default(false)
  isPublic      Boolean  @default(true) // Ko-fi "show me publicly" choice — gates the supporters wall
  matchedUserId String?  // resolved Da Vinci user, if the note matched one
  matchedUsername String? // denormalized for the public "recent supporters" feed
  apGranted     Int      @default(0)
  createdAt     DateTime @default(now())
}

// RETIRED with the arena-effect feature. Kept, not dropped — dropping a table
// on a deploy that runs db push is irreversible, and this one is inert.
model ArenaChestOpen {
  id        String   @id @default(uuid())
  userId    String
  rollId    String   // client-minted, one per button press
  chestId   String
  effectId  String
  isNew     Boolean  @default(false)
  refund    Int      @default(0)
  createdAt DateTime @default(now())

  @@unique([userId, rollId])
  @@index([userId])
}

// ═══ GUILD RAID BOSS (phase 1: realm mode) ═══════════════════════════════
// One boss per ISO week, lazily spawned by the first GET of the week — the
// gems weekKey pattern, no cron. Encounters are per-GROUP fights against
// that boss: today the only group is the whole server (guildId "realm");
// when guilds exist, per-guild rows slot in with zero schema change. The
// sentinel is a string, not null, because Postgres treats NULLs as distinct
// in unique constraints — a nullable guildId would allow duplicate realm
// encounters and the lazy-spawn race guard would silently stop guarding.

model RaidBoss {
  id         String          @id @default(uuid())
  week       String          @unique // gems-style ISO weekKey, e.g. "2026-W33"
  slug       String          // -> src/data/raidBosses.ts (name/series/gimmick)
  createdAt  DateTime        @default(now())
  encounters RaidEncounter[]
}

model RaidEncounter {
  id       String    @id @default(uuid())
  bossId   String
  guildId  String    @default("realm") // "realm" until guilds exist
  hpMax    Int
  hpLeft   Int
  killedAt DateTime?
  rewarded Boolean   @default(false) // settlement idempotency at rollover
  boss     RaidBoss  @relation(fields: [bossId], references: [id])
  attacks  RaidAttack[]

  @@unique([bossId, guildId])
}

model RaidAttack {
  id          String        @id @default(uuid())
  encounterId String
  userId      String        // plain string, no relation — the duel pattern
  day         String        // "2026-08-12" UTC; daily caps + fatigue key off this
  squad       Json          // per-card battle-report lines, replayable evidence
  damage      Int
  isRally     Boolean       @default(false) // the AP-bought third attack
  nonce       String        @unique // client idempotency — replays return the original
  createdAt   DateTime      @default(now())
  encounter   RaidEncounter @relation(fields: [encounterId], references: [id])

  @@index([encounterId, userId, day])
  @@index([userId, day])
}

// ═══ GUILDS (phase 4) ════════════════════════════════════════════════════
// Player-founded groups. All additive — `prisma db push` applies this with
// zero data loss. Name/tag shape rules (3-24 chars / 2-5 uppercase) are
// enforced in the controller; the DB only guarantees uniqueness. Level is
// COMPUTED from xp (floor(xp/1000)+1) — deliberately no column, so it can
// never drift from the xp that defines it.

model Guild {
  id          String        @id @default(uuid())
  name        String        @unique
  tag         String        @unique
  description String        @default("")
  avatar      String?
  leaderId    String        // plain string, no FK — the duel pattern
  coins       Int           @default(0)
  xp          Int           @default(0)
  createdAt   DateTime      @default(now())
  members     GuildMember[]
}

model GuildMember {
  id       String   @id @default(uuid())
  guildId  String
  // ONE guild per user — the whole design leans on this. The unique
  // constraint IS the rule, so a join race can't put someone in two guilds
  // any more than a crafted request can.
  userId   String   @unique
  role     String   @default("member") // "leader" | "member"
  joinedAt DateTime @default(now())
  guild    Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@index([guildId])
}

// A card lent to a fellow guild member. The card NEVER changes hands — the
// borrower's raids read the OWNER's UserCard row (stats, prints), and
// injuries land on the owner's row too: lending is real, your card comes
// back tired. Active = expiresAt > now; the unique triple makes re-lending
// the same card to the same person an upsert that refreshes the expiry.
model GuildCardLoan {
  id         String   @id @default(uuid())
  guildId    String
  ownerId    String
  borrowerId String
  cardId     String   // id in the server-side card catalog
  createdAt  DateTime @default(now())
  expiresAt  DateTime

  @@unique([ownerId, cardId, borrowerId])
  @@index([borrowerId])
  @@index([guildId])
}
